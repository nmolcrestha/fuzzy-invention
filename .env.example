# --- Database ---
# Local Postgres (or `docker compose up -d`, which exposes port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/side_quest

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Published sites live at <subdomain>.<root domain>
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Email (optional in development) ---
# Without RESEND_API_KEY, auth emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Side Quest <onboarding@resend.dev>"

# --- Google OAuth (optional, P1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
